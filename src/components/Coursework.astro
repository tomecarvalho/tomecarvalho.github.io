---
import type { Props as CourseworkSemesterProps } from "./CourseworkSemester.astro";
import CourseworkSemester from "./CourseworkSemester.astro";
import Stack from "./Stack.astro";

export interface Props {
  coursework: {
    title: string;
    semesters: CourseworkSemesterProps["semester"][];
  }[];
}

const { coursework } = Astro.props;
---

<Stack gap={2}>
  {
    coursework.map((year) => (
      <Stack as="article" gap={2}>
        <h3 class="year-title">{year.title}</h3>
        <div class="semesters">
          {year.semesters.map((semester) => (
            <CourseworkSemester semester={semester} />
          ))}
        </div>
      </Stack>
    ))
  }
</Stack>

<style>
  .year-title {
    font-size: 1.25rem;
  }

  .semesters {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  /* Two columns on wide windows. Single column on narrow windows. */
  @media (min-width: 900px) {
    .semesters {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
