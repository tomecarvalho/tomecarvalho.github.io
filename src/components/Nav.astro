---
import type { TranslatedNavRoute } from "../routes/nav-routes";

export interface Props {
  routes: TranslatedNavRoute[];
}

const { routes } = Astro.props;
const { pathname } = Astro.url;
---

<nav class="nav">
  {
    routes.map(({ path, label }) => (
      <a href={path} class:list={[{ active: pathname === path }]}>
        {label}
      </a>
    ))
  }
</nav>

<style>
  .nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav a {
    white-space: nowrap;
  }

  .nav a.active {
    font-weight: 500;
  }

  /* Narrow windows: Nav links are displayed in a dropdown menu. */
  @media (max-width: 640px) {
    .nav {
      position: absolute;
      top: 125%;
      right: 0;
      background-color: white;
      border: 1px solid black;
      display: none;
      flex-direction: column;
      gap: 0;
    }

    .nav.open {
      display: flex;
    }

    .nav a {
      padding: 1rem 1.5rem;
    }
  }
</style>
