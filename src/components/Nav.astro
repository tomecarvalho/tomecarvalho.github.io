---
/**
 * Route navigation component.
 * On wide windows:
 * - Routes arranged horizontally.
 * - Current route highlighted through its font weight.
 * On narrow windows:
 * - Routes collapsed into a dropdown menu.
 * - Current route highlighted through a check icon.
 */

import type { TranslatedNavRoute } from "../routes/nav-routes";
import { Icon } from "astro-icon/components";

export interface Props {
  routes: TranslatedNavRoute[];
}

const { routes } = Astro.props;
const { pathname } = Astro.url;
---

<nav class="nav">
  {
    routes.map(({ path, label, icon, originalPath }) => {
      const current = pathname === originalPath;

      const iconEl = !!icon && <Icon name={icon} />;

      return (
        <a href={path} class:list={[{ current }]}>
          <span>
            {iconEl}
            {label}
          </span>
          <Icon name="mdi:check" class:list={["check", { current }]} />
        </a>
      );
    })
  }
</nav>

<style>
  .nav {
    display: flex;
    gap: 1.5rem;
  }

  .nav > a {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .nav > a:hover {
    text-decoration: underline;
  }

  .nav > a.current {
    font-weight: bold;
  }

  .nav > a > span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .check {
    display: none;
  }

  /* Narrow windows: Nav links are displayed in a dropdown menu. */
  @media (max-width: 715px) {
    .nav {
      position: absolute;
      top: 100%;
      right: 0;
      z-index: 10;
      background-color: Canvas;
      border: 1px solid;
      padding: 0.5rem;
      display: none;
      flex-direction: column;
      gap: 0.5rem;
    }

    .nav.open {
      display: flex;
    }

    .check {
      /* Render invisible check icon for other routes, keeping width consistent. */
      display: block;
      opacity: 0;
    }
    .check.current {
      opacity: 1;
    }
  }
</style>
