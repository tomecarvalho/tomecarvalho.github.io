---
/**
 * Route navigation, laid out horizontally like a statusline's workspaces.
 * Narrow windows have no room for it, and reach the routes through the
 * launcher in the header instead.
 */

import type { TranslatedNavRoute } from "../routes/nav-routes";
import { Icon } from "astro-icon/components";

export interface Props {
  routes: (TranslatedNavRoute & { originalPath: string })[];
}

const { routes } = Astro.props;
const { pathname } = Astro.url;
---

<nav class="nav">
  {
    routes.map(({ path, label, icon, originalPath }) => (
      <a href={path} class:list={[{ current: pathname === originalPath }]}>
        {!!icon && <Icon name={icon} />}
        {label}
      </a>
    ))
  }
</nav>

<style>
  .nav {
    display: flex;
    gap: 0.5rem;
  }

  .nav > a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* No vertical padding: the highlight fills the bar, like a statusline. */
    padding: 0 0.5rem;
    color: var(--color-fg-dim);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav > a:hover {
    background-color: var(--color-surface);
    color: var(--color-fg);
  }

  /* The current route is highlighted like selected text in an editor. */
  .nav > a.current,
  .nav > a.current:hover {
    background-color: var(--color-selection);
    color: var(--color-fg);
  }

  @media (max-width: 715px) {
    .nav {
      display: none;
    }
  }
</style>
