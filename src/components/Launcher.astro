---
/**
 * Route navigation as a rofi-style launcher: a centred panel with a filter
 * prompt and the routes as entries, driven by the keyboard.
 */

import { Icon } from "astro-icon/components";
import type { LanguageOption } from "../i18n/types";
import type { SearchEntry } from "../search/types";
import type { Props as NavProps } from "./Nav.astro";

export type Props = {
  routes: NavProps["routes"];
  contacts: SearchEntry[];
  searchEntries: SearchEntry[];
  languageOptions: LanguageOption[];
  text: {
    /** The launcher's mode, shown as rofi shows the one it's running in. */
    routesPrompt: string;
    contactsPrompt: string;
    searchPrompt: string;
    languagePrompt: string;
    filter: string;
    hints: string;
  };
};

const {
  routes,
  contacts,
  searchEntries,
  languageOptions,
  text: {
    routesPrompt,
    contactsPrompt,
    searchPrompt,
    languagePrompt,
    filter,
    hints,
  },
} = Astro.props;

const { pathname } = Astro.url;
---

<dialog class="launcher" aria-labelledby="launcher-mode">
  <div class="launcher-prompt">
    <span
      class="launcher-mode"
      id="launcher-mode"
      data-routes-prompt={routesPrompt}
      data-contacts-prompt={contactsPrompt}
      data-search-prompt={searchPrompt}
      data-language-prompt={languagePrompt}
    >
      {routesPrompt}:
    </span>
    <input
      class="launcher-filter"
      type="text"
      aria-label={filter}
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <ul class="launcher-list" data-mode="routes">
    {
      routes.map(({ path, label, icon, originalPath }) => (
        <li>
          <a
            class:list={[
              "launcher-item",
              { current: pathname === originalPath },
            ]}
            href={path}
            data-label={label}
          >
            <span class="launcher-name">
              {!!icon && <Icon name={icon} />}
              {label}
            </span>
            <Icon name="mdi:check" class="launcher-check" />
          </a>
        </li>
      ))
    }
  </ul>
  <ul class="launcher-list" data-mode="search" hidden>
    {
      searchEntries.map(({ label, context, href, icon, value, keywords }) => (
        <li>
          <a
            class="launcher-item"
            href={href}
            data-label={[label, context, keywords].filter(Boolean).join(" ")}
          >
            <span class="launcher-name">
              <Icon name={icon} />
              <span class="launcher-result">
                <span>{label}</span>
                <span class="launcher-context">
                  {context}
                  {value && <span class="launcher-value">{value}</span>}
                </span>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <ul class="launcher-list" data-mode="contacts" hidden>
    {
      contacts.map(({ label, context, href, icon, value, keywords }) => (
        <li>
          <a
            class="launcher-item"
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            data-label={[label, context, keywords].filter(Boolean).join(" ")}
          >
            <span class="launcher-name">
              <Icon name={icon} />
              <span class="launcher-result">
                <span>{label}</span>
                <span class="launcher-context">{value || context}</span>
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <ul class="launcher-list" data-mode="language" hidden>
    {
      languageOptions.map(({ label, flag, href, current }) => (
        <li>
          <a
            class:list={["launcher-item", { current }]}
            href={href}
            data-label={label}
          >
            <span class="launcher-name">
              <span class="launcher-flag">{flag}</span>
              {label}
            </span>
            <Icon name="mdi:check" class="launcher-check" />
          </a>
        </li>
      ))
    }
  </ul>
  <footer class="launcher-footer">
    <div class="launcher-modes">
      <button class="launcher-mode-button" data-mode-button="search">
        {searchPrompt}
      </button>
      <button class="launcher-mode-button active" data-mode-button="routes">
        {routesPrompt}
      </button>
      <button class="launcher-mode-button" data-mode-button="contacts">
        {contactsPrompt}
      </button>
      <button class="launcher-mode-button" data-mode-button="language">
        {languagePrompt}
      </button>
    </div>
    <p class="launcher-hints">{hints}</p>
  </footer>
</dialog>

<script>
  const launcher = document.querySelector<HTMLDialogElement>(".launcher");
  const filter = launcher?.querySelector<HTMLInputElement>(".launcher-filter");
  const prompt = launcher?.querySelector<HTMLElement>(".launcher-mode");
  const lists = [
    ...(launcher?.querySelectorAll<HTMLElement>(".launcher-list") ?? []),
  ];
  const modeButtons = [
    ...(launcher?.querySelectorAll<HTMLButtonElement>("[data-mode-button]") ??
      []),
  ];
  const items = [
    ...(launcher?.querySelectorAll<HTMLAnchorElement>(".launcher-item") ?? []),
  ];

  const modes = ["search", "routes", "contacts", "language"] as const;

  type Mode = (typeof modes)[number];

  let mode: Mode = "routes";

  const shortcutModes: Record<string, Mode> = {
    s: "search",
    r: "routes",
    c: "contacts",
    l: "language",
  } as const;

  /** Diacritics are awkward to type, so they shouldn't stand between a match. */
  const fold = (value: string) =>
    value
      .normalize("NFD")
      .replace(/\p{Diacritic}/gu, "")
      .toLowerCase();

  const isVisible = (item: HTMLAnchorElement) =>
    !item.closest<HTMLElement>(".launcher-list")?.hidden &&
    !item.parentElement?.hasAttribute("hidden");

  const select = (item: HTMLAnchorElement) => {
    for (const other of items)
      other.classList.toggle("selected", other === item);
    item.scrollIntoView({ block: "nearest" });
  };

  const applyFilter = () => {
    const query = fold(filter?.value ?? "");

    for (const item of items) {
      const matches = fold(item.dataset.label ?? "").includes(query);
      item.parentElement?.toggleAttribute("hidden", !matches);
    }

    const [first] = items.filter(isVisible);
    if (first) select(first);
  };

  const setMode = (nextMode: Mode) => {
    mode = nextMode;

    for (const list of lists) list.hidden = list.dataset.mode !== mode;
    for (const button of modeButtons)
      button.classList.toggle("active", button.dataset.modeButton === mode);

    if (prompt) prompt.textContent = `${prompt.dataset[`${mode}Prompt`]}:`;

    if (filter) filter.value = "";
    applyFilter();

    /* Routes and languages mark where you are, so start the cursor there. */
    const current = items.find(
      (item) => isVisible(item) && item.classList.contains("current"),
    );
    if (current) select(current);

    filter?.focus();
  };

  const open = (initialMode: Mode) => {
    if (!launcher) return;

    launcher.showModal();
    setMode(initialMode);
  };

  const triggers = document.querySelectorAll("[data-launcher-trigger]");

  /* Each header button stands in for a control, so it opens on that mode. */
  for (const trigger of triggers) {
    trigger.addEventListener("click", () => {
      trigger.setAttribute("aria-expanded", "true");
      open((trigger.getAttribute("data-launcher-trigger") || "routes") as Mode);
    });
  }

  for (const button of modeButtons) {
    button.addEventListener("click", () =>
      setMode(button.dataset.modeButton as Mode),
    );
  }

  const isTyping = (target: EventTarget | null) =>
    target instanceof HTMLElement &&
    (target.isContentEditable ||
      ["INPUT", "SELECT", "TEXTAREA"].includes(target.tagName));

  /* Wide windows hide the trigger, so the launcher answers to keybindings. */
  document.addEventListener("keydown", (event) => {
    const plain = !event.altKey && !event.ctrlKey && !event.metaKey;
    const shortcut = shortcutModes[event.key.toLowerCase()];
    if (!shortcut || !plain || isTyping(event.target)) return;

    event.preventDefault();

    for (const trigger of triggers)
      trigger.setAttribute("aria-expanded", "true");

    open(shortcut);
  });

  launcher?.addEventListener("close", () => {
    for (const trigger of document.querySelectorAll("[data-launcher-trigger]"))
      trigger.setAttribute("aria-expanded", "false");
  });

  /* The panel covers the dialog's box, so a click on it landed on the backdrop. */
  launcher?.addEventListener("click", ({ target }) => {
    if (target === launcher) launcher.close();
  });

  for (const item of items)
    item.addEventListener("click", () => launcher?.close());

  filter?.addEventListener("input", applyFilter);

  launcher?.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      event.preventDefault();
      launcher.close();
      return;
    }

    if (event.key === "Tab") {
      event.preventDefault();

      const step = event.shiftKey ? modes.length - 1 : 1;
      setMode(modes[(modes.indexOf(mode) + step) % modes.length]!);
      return;
    }

    const visible = items.filter(isVisible);
    if (!visible.length) return;

    const selected = visible.findIndex((item) =>
      item.classList.contains("selected"),
    );

    switch (event.key) {
      case "ArrowDown":
        event.preventDefault();
        select(visible[(selected + 1) % visible.length]!);
        break;
      case "ArrowUp":
        event.preventDefault();
        select(visible[(selected - 1 + visible.length) % visible.length]!);
        break;
      case "Enter":
        event.preventDefault();
        visible[Math.max(selected, 0)]!.click();
        break;
    }
  });
</script>

<style>
  .launcher {
    /* `auto` margins centre the panel against the viewport. */
    margin: auto;
    padding: 0;
    /* Wide enough for the footer's modes and hints in the wordiest locale. */
    width: min(42rem, calc(100vw - 2rem));
    border: 2px solid var(--color-border);
    background-color: var(--color-bg-float);
    color: var(--color-fg);
    font-family: var(--font-mono);
  }

  .launcher::backdrop {
    background-color: rgb(0 0 0 / 0.5);
  }

  .launcher-prompt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.5rem;
    border-bottom: 1px solid var(--color-surface);
  }

  .launcher-mode {
    color: var(--color-accent);
  }

  .launcher-filter {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
  }

  .launcher-filter:focus-visible {
    outline: none;
  }

  .launcher-list {
    max-height: min(24rem, 60vh);
    padding: 0.25rem 0;
    list-style: none;
    overflow-y: auto;
  }

  .launcher-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.2rem 0.5rem;
    color: var(--color-fg-dim);
    text-decoration: none;
  }

  /* The entry under the cursor, highlighted as the launcher's selection. */
  .launcher-item.selected {
    background-color: var(--color-selection);
    color: var(--color-fg);
  }

  .launcher-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 1;
    min-width: 0;
  }

  /* A long label ellipsises rather than squashing the icons beside it. */
  .launcher-name svg,
  .launcher-flag,
  .launcher-check {
    flex: none;
  }

  .launcher-result {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    line-height: 1.25;
  }

  .launcher-result > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .launcher-context {
    display: flex;
    justify-content: space-between;
    color: var(--color-fg-muted);
    font-size: 0.75rem;
  }

  .launcher-value {
    margin-left: 1rem;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: right;
    white-space: nowrap;
  }

  .launcher-item.selected .launcher-context {
    color: var(--color-fg-dim);
  }

  /* Marks the page you're on, which the selection moves away from. */
  .launcher-check {
    opacity: 0;
  }

  .launcher-item.current .launcher-check {
    opacity: 1;
  }

  .launcher-footer {
    display: flex;
    /* A longer translation wraps onto its own line instead of overflowing. */
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.25rem 0.5rem;
    border-top: 1px solid var(--color-surface);
  }

  .launcher-modes {
    display: flex;
    gap: 0.25rem;
  }

  .launcher-mode-button {
    padding: 0 0.25rem;
    border: none;
    background: none;
    color: var(--color-fg-muted);
    font: inherit;
    cursor: pointer;
  }

  .launcher-mode-button.active {
    background-color: var(--color-selection);
    color: var(--color-fg);
  }

  .launcher-hints {
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .launcher-footer {
      align-items: stretch;
      flex-direction: column;
      flex-wrap: nowrap;
      gap: 0.25rem;
    }

    .launcher-hints {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>
