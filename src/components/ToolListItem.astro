---
import type { TranslatedTool } from "../types/data/tools/Tool";
import Paragraphs from "./Paragraphs.astro";
import Stack from "./Stack.astro";
import ToolListLink from "./ToolListLink.astro";

interface Props {
  tool: TranslatedTool;
}

const {
  self: Self,
  props: {
    tool: { name, type, description, href, children, links },
  },
} = Astro;

const hasChildren = !!children?.length;
const hasLinks = !!links?.length;
---

<li class="item">
  <Stack gap={1}>
    <a href={href}>
      <h3>{`${name} - ${type}`}</h3>
    </a>
    <Paragraphs paragraphs={description} />
  </Stack>
  {
    hasLinks && (
      <ul class="links">
        {links.map((link) => (
          <li>
            <ToolListLink link={link} />
          </li>
        ))}
      </ul>
    )
  }
  {
    hasChildren && (
      <ul class="children">
        {children.map((child) => (
          <Self tool={child} />
        ))}
      </ul>
    )
  }
</li>

<style>
  .item {
    list-style: none;
  }

  .children {
    margin-left: 1rem;
  }

  .children > li {
    list-style: disc;
  }

  .links {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  .links > li {
    display: flex;
    min-width: 0;
  }

  .links :global(.tooltip-wrapper),
  .links :global(.link) {
    width: 100%;
    min-width: 0;
  }

  .links :global(.tooltip-wrapper) {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .links :global(.link) {
    box-sizing: border-box;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
