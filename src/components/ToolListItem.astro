---
import type { TranslatedTool } from "../types/data/tools/Tool";
import Paragraphs from "./Paragraphs.astro";
import Stack from "./Stack.astro";
import ToolListLinks from "./ToolListLinks.astro";

interface Props {
  tool: TranslatedTool;
}

const {
  self: Self,
  props: {
    tool: { name, type, description, href, children, links },
  },
} = Astro;

const hasChildren = !!children?.length;
const hasLinks = !!links?.length;
---

<li class="item">
  <Stack gap={1}>
    <a href={href}>
      <h3>{`${name} - ${type}`}</h3>
    </a>
    <Paragraphs paragraphs={description} />
  </Stack>
  {hasLinks && <ToolListLinks links={links} />}
  {
    hasChildren && (
      <ul class="children">
        {children.map((child) => (
          <Self tool={child} />
        ))}
      </ul>
    )
  }
</li>

<style>
  .item {
    list-style: none;
  }

  .children {
    margin-left: 1rem;
  }

  .children > li {
    list-style: disc;
  }
</style>
