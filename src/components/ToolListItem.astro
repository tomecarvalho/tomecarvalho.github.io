---
import type { TranslatedTool } from "../types/data/tools/Tool";
import { toolTargetId } from "../search";
import RichText from "./RichText.astro";
import type { Props as RichTextProps } from "./RichText.astro";
import Stack from "./Stack.astro";
import ToolListLinks from "./ToolListLinks.astro";

interface Props {
  tool: TranslatedTool;
  categoryId: string;
  path: number[];
  targetId: string;
}

const {
  self: Self,
  props: {
    tool: { name, type, description, href, children, links },
    categoryId,
    path,
    targetId,
  },
} = Astro;

const Description: RichTextProps["Content"] = description;
const hasChildren = !!children?.length;
const hasLinks = !!links?.length;
---

<li class="item" id={targetId}>
  <Stack gap={1}>
    <a href={href}>
      <h3>{`${name} - ${type}`}</h3>
    </a>
    <RichText Content={Description} />
  </Stack>
  {hasLinks && <ToolListLinks links={links} />}
  {
    hasChildren && (
      <ul class="children">
        {children.map((child, childIndex) => (
          <Self
            tool={child}
            categoryId={categoryId}
            path={[...path, childIndex]}
            targetId={toolTargetId(categoryId, [...path, childIndex])}
          />
        ))}
      </ul>
    )
  }
</li>

<style>
  .item {
    list-style: none;
  }

  .item > :global(.tool-list-links),
  .children {
    margin-top: 1rem;
  }

  .children {
    margin-left: 1rem;
  }

  .children > li {
    list-style: disc;
  }

  .children > li + li {
    margin-top: 1rem;
  }
</style>
