---
import type { AsProp } from "../types/component/AsProp";

type Props = {
  id?: string;
  class?: string;
  hoverable?: boolean;
  /** Drops the surface fill, for papers that already sit on one. */
  flat?: boolean;
} & AsProp;

const {
  id,
  class: className,
  as: Tag = "div",
  hoverable = false,
  flat = false,
} = Astro.props;
---

<Tag id={id} class:list={["paper", { hoverable, flat }, className]}>
  <slot />
</Tag>

<style>
  .paper {
    padding: 1rem 1.25rem;
    background-color: var(--color-surface);
  }

  .paper.flat {
    padding-inline: 0;
    background-color: transparent;
  }

  .paper.hoverable:hover {
    background-color: var(--color-surface-hover);
  }
</style>
