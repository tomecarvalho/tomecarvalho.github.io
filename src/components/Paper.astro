---
import type { AsProp } from "../types/component/AsProp";

type Props = {
  class?: string;
  hoverable?: boolean;
} & AsProp;

const { class: className, as: Tag = "div", hoverable = false } = Astro.props;
---

<!-- Surface hook for themes. Unstyled while the site is plain. -->
<Tag class:list={["paper", { hoverable }, className]}>
  <slot />
</Tag>
