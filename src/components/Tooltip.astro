---
interface Props {
  text?: string;
}

const { text } = Astro.props;
---

<span class="tooltip-wrapper">
  <slot />
  {text && <span class="tooltip">{text}</span>}
</span>

<script>
  const tooltipOffset =
    parseInt(
      getComputedStyle(document.documentElement).getPropertyValue(
        "--tooltip-offset",
      ),
      10,
    ) || 8;

  const wrappers = document.querySelectorAll(".tooltip-wrapper");

  for (const wrapper of wrappers) {
    const tooltip = wrapper.querySelector(".tooltip");
    if (!(tooltip instanceof HTMLElement)) continue;

    wrapper.addEventListener("mouseenter", () => {
      const rect = wrapper.getBoundingClientRect();

      // Temporarily make it visible so we can measure it.
      tooltip.style.visibility = "visible";
      tooltip.style.opacity = "0";

      // Centre tooltip on the wrapper.
      const centeredLeft = rect.left + rect.width / 2 - tooltip.offsetWidth / 2;

      // Clamp within viewport.
      const clamped = Math.min(
        Math.max(centeredLeft, tooltipOffset),
        window.innerWidth - tooltip.offsetWidth - tooltipOffset,
      );

      tooltip.style.top = `${rect.top - tooltip.offsetHeight - tooltipOffset}px`;
      tooltip.style.left = `${clamped}px`;

      // Let CSS take over from here.
      tooltip.style.visibility = "";
      tooltip.style.opacity = "";
    });
  }
</script>
