---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import { appendSiteName } from "../site/utils";
import type { Props as CourseworkProps } from "./Coursework.astro";
import Coursework from "./Coursework.astro";

export interface Props {
  text: {
    title: string;
    coursework: string;
  };
  coursework: CourseworkProps["coursework"];
}

const {
  text: { title, coursework: courseworkTitle },
  coursework,
} = Astro.props;

const layoutTitle = appendSiteName(title);
---

<Layout title={layoutTitle}>
  <h1>{title}</h1>
  <div class="sections">
    <section>
      <h2 class="coursework-title">
        <Icon name="mdi:university" />
        {courseworkTitle}
      </h2>
      <Coursework coursework={coursework} />
    </section>
  </div>
</Layout>

<style>
  .sections {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .coursework-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
</style>
