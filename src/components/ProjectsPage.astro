---
import type { Translated } from "../i18n/types";
import Layout from "../layouts/Layout.astro";
import { appendSiteName } from "../site/utils";
import type { ProjectCategory } from "../types/data/projects/ProjectCategory";
import type { Props as CourseworkProps } from "./Coursework.astro";
import Coursework from "./Coursework.astro";
import Project from "./Project.astro";
import ProjectsSection from "./ProjectsSection.astro";
import Stack from "./Stack.astro";

export interface Props {
  text: {
    title: string;
    coursework: string;
  };
  coursework?: CourseworkProps["coursework"];
  projectCategories?: Translated<ProjectCategory>[];
}

const {
  text: { title, coursework: courseworkTitle },
  coursework,
  projectCategories,
} = Astro.props;

const layoutTitle = appendSiteName(title);
---

<Layout title={layoutTitle}>
  <Stack gap={4}>
    <h1>{title}</h1>
    <Stack gap={4}>
      {
        projectCategories?.map(({ name, icon, projects }) => (
          <ProjectsSection name={name} icon={icon}>
            {projects.map((project) => (
              <Project {...project} />
            ))}
          </ProjectsSection>
        ))
      }
      {
        !!coursework && (
          <ProjectsSection name={courseworkTitle} icon="mdi:university">
            <Coursework coursework={coursework} />
          </ProjectsSection>
        )
      }
    </Stack>
  </Stack>
</Layout>
