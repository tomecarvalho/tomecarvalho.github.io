---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import { appendSiteName } from "../site/utils";
import type { Props as CourseworkProps } from "./Coursework.astro";
import Coursework from "./Coursework.astro";
import Stack from "./Stack.astro";
import JointPapers from "./JointPapers.astro";
import Paper from "./Paper.astro";

export interface Props {
  text: {
    title: string;
    coursework: string;
  };
  coursework: CourseworkProps["coursework"];
}

const {
  text: { title, coursework: courseworkTitle },
  coursework,
} = Astro.props;

const layoutTitle = appendSiteName(title);
---

<Layout title={layoutTitle}>
  <Stack gap={4}>
    <h1>{title}</h1>
    <Stack gap={4}>
      <Stack as="section" gap={2}>
        <Stack as="h2" direction="row" gap={1} alignItems="center">
          <Icon name="mdi:university" />
          {courseworkTitle}
        </Stack>
        <Coursework coursework={coursework} />
      </Stack>
    </Stack>
  </Stack>
</Layout>
