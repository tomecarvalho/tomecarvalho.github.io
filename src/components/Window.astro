---
/**
 * Wraps content in a tiling window manager's chrome: a titlebar above a
 * bordered content area. The titlebar shades the window, like i3.
 * The chrome itself is styled globally by the layout.
 */

import { Icon } from "astro-icon/components";
import type { As, AsProp } from "../types/component/AsProp";

export type Props = {
  id: string;
  title: string;
  icon?: string;
  /** Element for the titlebar text. Use a heading when it labels a section. */
  titleAs?: As;
  defaultOpen?: boolean;
  class?: string;
} & AsProp;

const {
  id,
  title,
  icon,
  titleAs: TitleTag = "div",
  defaultOpen = true,
  as: Tag = "section",
  class: className,
} = Astro.props;

const sectionId = `window-${id}`;
---

<Tag class:list={["window", className]}>
  <TitleTag class="window-title">
    <button
      class="window-trigger"
      type="button"
      id={`${sectionId}-trigger`}
      aria-expanded={defaultOpen}
      aria-controls={sectionId}
    >
      <span class="window-name">
        {icon && <Icon name={icon} />}
        <span class="window-label">{title}</span>
      </span>
      <Icon
        name="mdi:chevron-down"
        id={`${sectionId}-icon`}
        style={defaultOpen ? "" : "transform: rotate(-90deg)"}
      />
    </button>
  </TitleTag>
  <div
    class="window-content"
    id={sectionId}
    style={defaultOpen ? "" : "display: none"}
  >
    <slot />
  </div>
</Tag>

<script is:inline define:vars={{ sectionId, defaultOpen }}>
  const content = document.getElementById(sectionId);
  const trigger = document.getElementById(`${sectionId}-trigger`);
  const icon = document.getElementById(`${sectionId}-icon`);

  let open = defaultOpen;

  const setOpen = (nextOpen) => {
    open = nextOpen;
    content.style.display = open ? "" : "none";
    icon.style.transform = open ? "" : "rotate(-90deg)";
    trigger.setAttribute("aria-expanded", open);
  };

  trigger.addEventListener("click", () => setOpen(!open));

  /* Search results can point inside a shaded window. Reveal the destination
     before scrolling to it, both after a page load and for same-page results. */
  const revealHashTarget = () => {
    const target = document.getElementById(location.hash.slice(1));
    if (!target || !content.contains(target)) return;

    setOpen(true);
    requestAnimationFrame(() => target.scrollIntoView({ block: "center" }));
  };

  window.addEventListener("hashchange", revealHashTarget);
  revealHashTarget();
</script>
