---
import type { AsProp } from "../types/component/AsProp";

type Props = {
  class?: string;
} & AsProp;

const { class: className, as: Tag = "div" } = Astro.props;
---

<Tag class:list={["joint-papers", className]}>
  <slot />
</Tag>

<style>
  .joint-papers {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
