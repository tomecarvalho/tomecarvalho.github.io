---
import type { Contact } from "../types/data/about-me/Contact";
import { Icon } from "astro-icon/components";
import UnstyledButton from "./UnstyledButton.astro";

export interface Props {
  contact: Contact;
}

const {
  contact: { id, icon, label, value, href },
} = Astro.props;
---

{
  value ? (
    <div class="contact">
      <a class="contactAnchor" href={href} title={label}>
        <Icon name={icon} size="1.5rem" />
      </a>
      <hr class="divider" />
      <UnstyledButton
        type="button"
        aria-label="Copy to clipboard"
        title="Copy to clipboard"
        data-copy-value={value}
        id={id}
        class="clipboard-button"
      >
        <Icon name="mdi:content-copy" size="1.25rem" />
      </UnstyledButton>
    </div>
  ) : (
    <a class="contact contactAnchor" href={href} title={label}>
      <Icon name={icon} size="1.5rem" />
    </a>
  )
}

<script>
  document.addEventListener("click", async ({ target }) => {
    if (!(target instanceof Element)) return;

    const button = target.closest(".contact button");
    const copyValue = button?.getAttribute("data-copy-value");

    if (copyValue) await navigator.clipboard.writeText(copyValue);
  });
</script>

<style>
  .contact {
    display: flex;
    text-wrap: nowrap;
    gap: 0.5rem;
    font-size: 1rem;
    align-items: center;
  }

  .contactAnchor {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem;
    border-radius: 0.5rem;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .contactAnchor:hover,
  .clipboard-button:hover {
    background-color: var(--color-surface);
  }

  .divider {
    height: 1.5rem;
    width: 1px;
    border: none;
    background-color: var(--color-border);
  }

  /* An action alongside the contact links, so it takes their colour too. */
  .clipboard-button {
    display: flex;
    padding: 0.25rem;
    border-radius: 0.5rem;
    color: var(--color-link);
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .clipboard-button:hover {
    color: var(--color-link-hover);
  }
</style>
