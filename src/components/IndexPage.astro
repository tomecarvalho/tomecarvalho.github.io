---
import Layout from "../layouts/Layout.astro";
import { appendSiteName } from "../site/utils";
import type { Props as ContactsProps } from "./Contacts.astro";
import Contacts from "./Contacts.astro";
import type { Props as ParagraphsProps } from "./Paragraphs.astro";
import Paragraphs from "./Paragraphs.astro";

export interface Props {
  text: {
    title: string;
    name: string;
    role: string;
    location: string;
    description: ParagraphsProps["paragraphs"];
  };
  contacts: ContactsProps["contacts"];
}

const {
  text: { title, name, role, location, description },
  contacts,
} = Astro.props;

const layoutTitle = appendSiteName(title);

const roleAndLocation = `${role} - ${location}`;
---

<Layout title={layoutTitle}>
  <section>
    <h1 class="name">{name}</h1>
    <h3 class="role-and-location">{roleAndLocation}</h3>
    <Paragraphs paragraphs={description} />
    <Contacts contacts={contacts} />
  </section>
</Layout>

<style>
  .name {
    margin-bottom: 0.25rem;
  }

  .role-and-location {
    margin-bottom: 1rem;
  }
</style>
