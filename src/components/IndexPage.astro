---
import Layout from "../layouts/Layout.astro";
import type { TranslatedNavRoute } from "../routes/nav-routes";
import { appendSiteName } from "../site/utils";
import type { Props as ContactsProps } from "./Contacts.astro";
import Contacts from "./Contacts.astro";
import AutoGrid from "./AutoGrid.astro";
import ExploreCard from "./ExploreCard.astro";
import type { Props as ParagraphsProps } from "./Paragraphs.astro";
import Paragraphs from "./Paragraphs.astro";
import Stack from "./Stack.astro";
import Window from "./Window.astro";
export interface Props {
  text: {
    title: string;
    name: string;
    role: string;
    location: string;
    explore: string;
    description: ParagraphsProps["paragraphs"];
  };
  contacts: ContactsProps["contacts"];
  exploreRoutes: TranslatedNavRoute[];
}
const {
  text: { title, name, role, location, explore, description },
  contacts,
  exploreRoutes,
} = Astro.props;
const layoutTitle = appendSiteName(title);
const roleAndLocation = `${role} - ${location}`;
---

<Layout title={layoutTitle}>
  <Stack gap={2}>
    <Window id="about-me" title={title}>
      <Stack gap={4}>
        <Stack gap={0.5}>
          <h1 class="name">{name}</h1>
          <h3 class="role-and-location">{roleAndLocation}</h3>
        </Stack>
        <Stack gap={2}>
          <Paragraphs paragraphs={description} />
          <Contacts contacts={contacts} />
        </Stack>
      </Stack>
    </Window>
    <Window id="explore" title={explore} titleAs="h2">
      <AutoGrid minWidth="300px" gap={3} stretch>
        {exploreRoutes.map((route) => <ExploreCard {...route} />)}
      </AutoGrid>
    </Window>
  </Stack>
</Layout>

<style>
  /* A subtitle to the name above it, rather than a heading in its own right. */
  .role-and-location {
    color: var(--color-fg-dim);
  }
</style>
