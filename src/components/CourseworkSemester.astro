---
import { courseworkTargetId } from "../search";
import type { Props as CourseworkSubjectProps } from "./CourseworkSubject.astro";
import CourseworkSubject from "./CourseworkSubject.astro";
import Stack from "./Stack.astro";

export interface Props {
  semester: {
    title: string;
    subjects: CourseworkSubjectProps["subject"][];
  };
  path: [number, number];
}

const { semester, path } = Astro.props;
---

<section class="semester" id={courseworkTargetId(...path)}>
  <h4 class="semester-title">{semester.title}</h4>
  <Stack gap={4}>
    {
      semester.subjects.map((subject, subjectIndex) => (
        <CourseworkSubject subject={subject} path={[...path, subjectIndex]} />
      ))
    }
  </Stack>
</section>

<style>
  .semester-title {
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }
</style>
