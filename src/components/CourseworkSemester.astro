---
import type { Props as CourseworkSubjectProps } from "./CourseworkSubject.astro";
import CourseworkSubject from "./CourseworkSubject.astro";

export interface Props {
  semester: {
    title: string;
    subjects: CourseworkSubjectProps["subject"][];
  };
}

const { semester } = Astro.props;
---

<section class="semester">
  <h4 class="semester-title">{semester.title}</h4>
  <div class="subjects">
    {
      semester.subjects.map((subject) => (
        <CourseworkSubject subject={subject} />
      ))
    }
  </div>
</section>

<style>
  .semester-title {
    margin-bottom: 1.25rem;
    font-size: 1rem;
  }

  .subjects {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
</style>
