---
import type { Spacing } from "../style/theme";
import { spacingToPx } from "../style/theme";
import type { AsProp } from "../types/component/AsProp";
import { toStyle } from "../utils/style";

type Props = {
  minWidth?: Spacing;
  maxWidth?: Spacing;
  gap?: Spacing;
  /** Whether extra columns collapse (`fit`) or stay open (`fill`). */
  columns?: "fill" | "fit";
  stretch?: boolean;
  class?: string;
} & AsProp;

const {
  minWidth = "12rem",
  maxWidth,
  gap = 2,
  columns = "fill",
  stretch = false,
  class: className,
  as: Tag = "div",
} = Astro.props;

const style = [
  toStyle({ gap }),
  `--auto-grid-min-width: ${spacingToPx(minWidth)};`,
  maxWidth && `--auto-grid-max-width: ${spacingToPx(maxWidth)};`,
]
  .filter(Boolean)
  .join(" ");
---

<Tag
  class:list={[
    "auto-grid",
    className,
    {
      stretch,
      "columns-fit": columns === "fit",
      "has-max-width": !!maxWidth,
      list: Tag === "ul",
    },
  ]}
  style={style}
>
  <slot />
</Tag>

<style>
  .auto-grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, var(--auto-grid-min-width, 12rem)), 1fr)
    );
  }

  .auto-grid.columns-fit {
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, var(--auto-grid-min-width, 12rem)), 1fr)
    );
  }

  .auto-grid.has-max-width {
    grid-template-columns: repeat(
      auto-fill,
      minmax(
        min(100%, var(--auto-grid-min-width, 12rem)),
        min(100%, var(--auto-grid-max-width))
      )
    );
  }

  .auto-grid.has-max-width.columns-fit {
    grid-template-columns: repeat(
      auto-fit,
      minmax(
        min(100%, var(--auto-grid-min-width, 12rem)),
        min(100%, var(--auto-grid-max-width))
      )
    );
  }

  .auto-grid.list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .auto-grid.stretch > :global(*) {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
  }
</style>
