---
import { Icon } from "astro-icon/components";
import type { SearchModeConfig } from "../search/types";
import Stack from "./Stack.astro";
import type { Translated } from "../i18n/types";

type Props = {
  searchModes: Translated<SearchModeConfig>[];
  hintsLabel: string;
  text: {
    shortcuts: string;
  };
};

const { searchModes, hintsLabel, text } = Astro.props;
---

<footer class="footer" aria-label={hintsLabel}>
  <div class="footer-content">
    <Stack direction="row" center gap={1}>
      <Icon name="mdi:keyboard" class="footer-icon" />
      <span>{text.shortcuts}:</span>
    </Stack>
    {
      searchModes.map(({ shortcut, label }) => (
        <span class="footer-shortcut">
          <kbd>{shortcut}</kbd>
          {label}
        </span>
      ))
    }
  </div>
</footer>

<style>
  .footer {
    position: fixed;
    left: 50%;
    bottom: 0.5rem;
    z-index: 20;
    display: flex;
    justify-content: center;
    flex-shrink: 0;
    width: fit-content;
    transform: translateX(-50%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-bg-float);
    box-shadow: var(--shadow-window);
    transition:
      background-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
  }

  .footer-content {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1rem;
    width: fit-content;
  }

  .footer-shortcut {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-fg-muted);
  }

  .footer-shortcut kbd {
    padding: 0 0.25rem;
    background-color: var(--color-selection);
    color: var(--color-fg);
    font: inherit;
    text-transform: uppercase;
  }

  @media (max-width: 715px) {
    .footer {
      display: none;
    }
  }
</style>
