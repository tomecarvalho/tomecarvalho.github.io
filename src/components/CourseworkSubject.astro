---
export interface Props {
  subject: {
    name: string;
    href: string;
    projects: {
      name: string;
      href: string;
      topics: string[];
    }[];
  };
}

const { subject } = Astro.props;
---

<div class="subject">
  <h5 class="subject-title">
    <a href={subject.href}>{subject.name}</a>
  </h5>
  <ul class="projects">
    {
      subject.projects.map(({ name, href, topics }) => {
        const topicsString = topics.join(", ");

        return (
          <Fragment>
            <li class="project">
              <a href={href}>{name}</a>
              <p class="topics">{topicsString}</p>
            </li>
          </Fragment>
        );
      })
    }
  </ul>
</div>

<style>
  .subject-title {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .projects {
    list-style: none;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .topics {
    font-size: 0.875rem;
  }
</style>
