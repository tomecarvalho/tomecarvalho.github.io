---
import Stack from "./Stack.astro";
import { courseworkTargetId } from "../search";

export interface Props {
  subject: {
    name: string;
    href: string;
    projects: {
      name: string;
      href: string;
      topics: string[];
    }[];
  };
  path: [number, number, number];
}

const { subject, path } = Astro.props;
---

<Stack class="subject" gap={1.5} id={courseworkTargetId(...path)}>
  <h5 class="subject-title">
    <a href={subject.href}>{subject.name}</a>
  </h5>
  <Stack as="ul" class="projects" gap={2}>
    {
      subject.projects.map(({ name, href, topics }, projectIndex) => {
        const topicsString = topics.join(", ");

        return (
          <Fragment>
            <Stack
              as="li"
              gap={0.5}
              id={courseworkTargetId(...path, projectIndex)}
            >
              <a href={href}>{name}</a>
              <span class="text-secondary">{topicsString}</span>
            </Stack>
          </Fragment>
        );
      })
    }
  </Stack>
</Stack>

<style>
  .subject-title {
    font-size: 1rem;
  }

  .projects {
    list-style: none;
  }
</style>
