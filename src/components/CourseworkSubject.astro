---
import Stack from "./Stack.astro";

export interface Props {
  subject: {
    name: string;
    href: string;
    projects: {
      name: string;
      href: string;
      topics: string[];
    }[];
  };
}

const { subject } = Astro.props;
---

<Stack class="subject" gap={1.5}>
  <h5 class="subject-title">
    <a href={subject.href}>{subject.name}</a>
  </h5>
  <Stack as="ul" class="projects" gap={2}>
    {
      subject.projects.map(({ name, href, topics }) => {
        const topicsString = topics.join(", ");

        return (
          <Fragment>
            <Stack as="li" gap={0.5}>
              <a href={href}>{name}</a>
              <span class="text-secondary">{topicsString}</span>
            </Stack>
          </Fragment>
        );
      })
    }
  </Stack>
</Stack>

<style>
  .subject-title {
    font-size: 1rem;
  }

  .projects {
    list-style: none;
  }
</style>
