---
import { splitParagraphs, type SplitParagraphsInput } from "../utils/string";

export interface Props {
  paragraphs: SplitParagraphsInput;
}

const { paragraphs } = Astro.props;

const paragraphsArray = splitParagraphs(paragraphs);
---

<div>
  {paragraphsArray.map((paragraph) => <p>{paragraph}</p>)}
</div>
