---
import type { TranslatedInterestCard } from "../types/data/interests/InterestCard";
import Paper from "./Paper.astro";
import Stack from "./Stack.astro";
import Tooltip from "./Tooltip.astro";

type Props = TranslatedInterestCard;

const { text, href, imageUrl } = Astro.props;

const hasImage = !!imageUrl;
const hasPrimary = !!text.primary;
const hasSecondary = !!text.secondary;
const hasTertiary = !!text.tertiary;
const hasText = hasPrimary || hasSecondary || hasTertiary;
---

<Tooltip text={text.tooltip ?? ""}>
  <a class="interest-card" href={href}>
    <Paper hoverable>
      <Stack gap={1.5} center>
        {
          hasImage && (
            <img class="thumbnail" src={imageUrl} alt={text.primary} />
          )
        }
        {
          hasText && (
            <Stack gap={0.5} alignItems="flex-start" fullWidth>
              {hasPrimary && <h4>{text.primary}</h4>}
              {hasSecondary && (
                <span class="text-secondary">{text.secondary}</span>
              )}
              {hasTertiary && (
                <span class="text-tertiary">{text.tertiary}</span>
              )}
            </Stack>
          )
        }
      </Stack>
    </Paper>
  </a>
</Tooltip>

<style>
  .interest-card {
    text-decoration: none;
    width: 100%;
    display: flex;
    flex-direction: column;
    min-height: 100%;
    color: inherit;
  }

  .interest-card :global(.paper) {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
  }

  .interest-card :global(.paper) > :global(.stack) {
    flex: 1;
  }

  .thumbnail {
    width: 100%;
    object-fit: cover;
    border-radius: calc(var(--paper-border-radius) * 0.75);
  }
</style>
