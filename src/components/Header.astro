---
import { Icon } from "astro-icon/components";
import type { Props as LauncherProps } from "./Launcher.astro";
import Launcher from "./Launcher.astro";
import type { Props as NavProps } from "./Nav.astro";
import Nav from "./Nav.astro";

export type Props = Pick<NavProps, "routes"> & {
  title: string;
  homeHref: string;
  languageOptions: LauncherProps["languageOptions"];
  contacts: LauncherProps["contacts"];
  searchEntries: LauncherProps["searchEntries"];
  launcherText: LauncherProps["text"];
  openLauncherLabel: string;
  openLanguageLabel: string;
};

const {
  routes,
  title,
  homeHref,
  languageOptions,
  contacts,
  searchEntries,
  launcherText,
  openLauncherLabel,
  openLanguageLabel,
} = Astro.props;

const currentLanguage = languageOptions.find(({ current }) => current);
---

<header class="header">
  <div class="header-content">
    <a class="header-title" href={homeHref}>{title}</a>
    <div class="header-end">
      <Nav routes={routes} />
      <button
        class="language-button"
        aria-label={openLanguageLabel}
        aria-expanded="false"
        data-launcher-trigger="language"
      >
        <Icon name="mdi:language" />
        {currentLanguage?.flag}
      </button>
      <button
        class="menu-button"
        aria-label={openLauncherLabel}
        aria-expanded="false"
        data-launcher-trigger="routes"
      >
        <Icon name="mdi:menu" />
      </button>
      <button
        class="search-button"
        aria-label={launcherText.searchPrompt}
        aria-expanded="false"
        data-launcher-trigger="search"
      >
        <Icon name="mdi:magnify" />
      </button>
    </div>
  </div>
</header>

<Launcher
  routes={routes}
  contacts={contacts}
  searchEntries={searchEntries}
  languageOptions={languageOptions}
  text={launcherText}
/>

<!--
Layouts ([Left] [Right])
- Wide: [Handle] [Nav, Language Button, Search Button]
- Narrow: [Handle] [Language Button, Launcher Button, Search Button]
-->
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    isolation: isolate;
    display: flex;
    justify-content: center;
    /* Fixed so that anchored targets know how far to clear it. */
    min-height: var(--header-height);
    width: 100%;
    background-color: var(--color-bg);
    box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 0.2);
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease;
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.375rem var(--content-padding-x);
    width: 100%;
  }

  .header-title {
    min-width: 0;
    overflow: hidden;
    padding: 0 0.625rem;
    border-radius: 999px;
    background-color: var(--color-surface);
    font-weight: bold;
    text-decoration: none;
    color: var(--color-accent);
    transition:
      background-color 160ms ease,
      color 160ms ease;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .header-title:hover {
    color: var(--color-accent-dim);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .language-button,
  .menu-button,
  .search-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background-color: var(--color-surface);
    color: inherit;
    font: inherit;
    line-height: 1;
    min-height: 1.5rem;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .language-button,
  .search-button {
    padding: 0 0.625rem;
  }

  .menu-button {
    display: none;
    font-size: 1.25rem;
  }

  /* Narrow: the nav routes move into the launcher this button opens. */
  @media (max-width: 715px) {
    .header {
      min-height: 2.5rem;
    }

    .header-end {
      gap: 1.25rem;
    }

    .language-button,
    .menu-button,
    .search-button {
      min-width: 1.5rem;
      min-height: 1.5rem;
      justify-content: center;
      font-size: 1.375rem;
    }

    .menu-button {
      display: inline-flex;
      padding: 0 0.625rem;
    }
  }
</style>
