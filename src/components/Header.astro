---
import { Icon } from "astro-icon/components";
import type { Props as LanguageSelectProps } from "./LanguageSelect.astro";
import LanguageSelect from "./LanguageSelect.astro";
import type { Props as NavProps } from "./Nav.astro";
import Nav from "./Nav.astro";
export type Props = Pick<NavProps, "routes"> & {
  title: string;
  homeHref: string;
  languageOptions: LanguageSelectProps["options"];
};
const { routes, title, homeHref, languageOptions } = Astro.props;
---

<header class="header">
  <div class="header-content">
    <a class="header-title" href={homeHref}>{title}</a>
    <div class="header-right">
      <div class="header-end">
        <LanguageSelect options={languageOptions} />
      </div>
      <div class="menu">
        <button
          class="menu-button text"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <Icon name="mdi:menu" />
        </button>
        <Nav routes={routes} />
      </div>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector(".menu-button");
  const nav = document.querySelector(".nav");
  const navLinks = nav?.querySelectorAll("a") ?? [];
  const header = document.querySelector(".header");
  const scrollContainer = document.querySelector("main");

  // Open the nav dropdown menu when the menu button is clicked.
  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", (!isOpen).toString());
    nav?.classList.toggle("open");
    menuButton.classList.toggle("open");
  });

  // Close the nav dropdown menu when a nav link is clicked.
  for (const link of navLinks)
    link.addEventListener("click", () => {
      menuButton?.setAttribute("aria-expanded", "false");
      nav?.classList.remove("open");
    });

  // Close the nav dropdown menu when the user clicks outside of it.
  document.addEventListener("click", ({ target }) => {
    if (target instanceof Element && !target.closest("header")) {
      menuButton?.setAttribute("aria-expanded", "false");
      nav?.classList.remove("open");
    }
  });

  // Add box-shadow to the header when it partially covers main content.
  scrollContainer?.addEventListener(
    "scroll",
    () => {
      header?.classList.toggle(
        "scrolled",
        (scrollContainer?.scrollTop ?? 0) > 0,
      );
    },
    { passive: true },
  );
</script>

<style>
  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    padding: 0 var(--content-padding-x);
    width: min(100%, var(--content-max-width));
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .menu {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .header {
    padding: 0.5rem 0;
    position: relative;
    display: flex;
    justify-content: center;
    transition: box-shadow 0.2s ease;
    font-weight: bold;
  }

  .header.scrolled {
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .menu-button {
    padding: 0.25rem !important;
    display: none;
    font-size: 1.5rem;
    border-radius: var(--button-border-radius);
    padding: var(--button-padding);
  }

  .menu-button:hover {
    background-color: var(--button-bg-color-hover-dark);
  }
  .menu-button:active,
  .menu-button.open {
    background-color: var(--button-bg-color-active-dark);
  }

  @media (max-width: 700px) {
    .menu {
      position: relative;
      left: auto;
      transform: none;
    }

    .menu-button {
      display: flex;
    }
  }
</style>
