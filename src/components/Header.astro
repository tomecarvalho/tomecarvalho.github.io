---
import { Icon } from "astro-icon/components";
import type { Props as LanguageSelectProps } from "./LanguageSelect.astro";
import LanguageSelect from "./LanguageSelect.astro";
import type { Props as NavProps } from "./Nav.astro";
import Nav from "./Nav.astro";
import type { Props as RouteLauncherProps } from "./RouteLauncher.astro";
import RouteLauncher from "./RouteLauncher.astro";

export type Props = Pick<NavProps, "routes"> & {
  title: string;
  homeHref: string;
  languageOptions: LanguageSelectProps["options"];
  launcherText: RouteLauncherProps["text"];
  openLauncherLabel: string;
};

const {
  routes,
  title,
  homeHref,
  languageOptions,
  launcherText,
  openLauncherLabel,
} = Astro.props;
---

<header class="header">
  <div class="header-content">
    <a class="header-title" href={homeHref}>{title}</a>
    <div class="header-end">
      <Nav routes={routes} />
      <LanguageSelect options={languageOptions} />
      <button
        class="menu-button"
        aria-label={openLauncherLabel}
        aria-expanded="false"
        data-launcher-trigger
      >
        <Icon name="mdi:menu" />
      </button>
    </div>
  </div>
</header>

<RouteLauncher routes={routes} text={launcherText} />

<!--
Layouts ([Left] [Right])
- Wide: [Handle] [Nav, Language Select]
- Narrow: [Handle] [Language Select, Launcher Button]
-->
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    background-color: var(--color-bg-float);
    font-family: var(--font-mono);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 var(--content-padding-x);
    width: min(100%, var(--content-max-width));
  }

  .header-title {
    font-weight: bold;
    text-decoration: none;
    color: var(--color-accent);
  }

  .header-title:hover {
    color: var(--color-accent-dim);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .menu-button {
    display: none;
    align-items: center;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }

  /* Narrow: the nav routes move into the launcher this button opens. */
  @media (max-width: 715px) {
    .menu-button {
      display: inline-flex;
    }
  }
</style>
