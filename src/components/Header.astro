---
import { Icon } from "astro-icon/components";
import type { Props as LauncherProps } from "./Launcher.astro";
import Launcher from "./Launcher.astro";
import type { Props as NavProps } from "./Nav.astro";
import Nav from "./Nav.astro";

export type Props = Pick<NavProps, "routes"> & {
  title: string;
  homeHref: string;
  languageOptions: LauncherProps["languageOptions"];
  contacts: LauncherProps["contacts"];
  searchEntries: LauncherProps["searchEntries"];
  launcherText: LauncherProps["text"];
  openLauncherLabel: string;
  openLanguageLabel: string;
};

const {
  routes,
  title,
  homeHref,
  languageOptions,
  contacts,
  searchEntries,
  launcherText,
  openLauncherLabel,
  openLanguageLabel,
} = Astro.props;

const currentLanguage = languageOptions.find(({ current }) => current);
---

<header class="header">
  <div class="header-content">
    <a class="header-title" href={homeHref}>{title}</a>
    <div class="header-end">
      <Nav routes={routes} />
      <button
        class="language-button"
        aria-label={openLanguageLabel}
        aria-expanded="false"
        data-launcher-trigger="language"
      >
        <Icon name="mdi:language" />
        {currentLanguage?.flag}
      </button>
      <button
        class="menu-button"
        aria-label={openLauncherLabel}
        aria-expanded="false"
        data-launcher-trigger="routes"
      >
        <Icon name="mdi:menu" />
      </button>
      <button
        class="search-button"
        aria-label={launcherText.searchPrompt}
        aria-expanded="false"
        data-launcher-trigger="search"
      >
        <Icon name="mdi:magnify" />
      </button>
    </div>
  </div>
</header>

<Launcher
  routes={routes}
  contacts={contacts}
  searchEntries={searchEntries}
  languageOptions={languageOptions}
  text={launcherText}
/>

<!--
Layouts ([Left] [Right])
- Wide: [Handle] [Nav, Language Button, Search Button]
- Narrow: [Handle] [Language Button, Launcher Button, Search Button]
-->
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    /* Fixed so that anchored targets know how far to clear it. */
    height: var(--header-height);
    background-color: var(--color-bg-float);
    font-family: var(--font-mono);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 var(--content-padding-x);
    width: min(100%, var(--content-max-width));
  }

  .header-title {
    font-weight: bold;
    text-decoration: none;
    color: var(--color-accent);
  }

  .header-title:hover {
    color: var(--color-accent-dim);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .language-button,
  .menu-button,
  .search-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .menu-button {
    display: none;
    font-size: 1.25rem;
  }

  /* Narrow: the nav routes move into the launcher this button opens. */
  @media (max-width: 715px) {
    .header {
      height: 2.5rem;
    }

    .header-end {
      gap: 1.25rem;
    }

    .language-button,
    .menu-button,
    .search-button {
      min-width: 1.5rem;
      min-height: 1.5rem;
      justify-content: center;
      font-size: 1.375rem;
    }

    .menu-button {
      display: inline-flex;
    }
  }
</style>
