---
import { Icon } from "astro-icon/components";
import type { Props as LanguageSelectProps } from "./LanguageSelect.astro";
import LanguageSelect from "./LanguageSelect.astro";
import type { Props as NavProps } from "./Nav.astro";
import Nav from "./Nav.astro";

export type Props = Pick<NavProps, "routes"> & {
  title: string;
  homeHref: string;
  languageOptions: LanguageSelectProps["options"];
};

const { routes, title, homeHref, languageOptions } = Astro.props;
---

<header class="header">
  <div class="header-content">
    <a class="header-title" href={homeHref}>{title}</a>
    <div class="header-end">
      <Nav routes={routes} />
      <LanguageSelect options={languageOptions} />
      <button
        class="menu-button"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="mdi:menu" />
      </button>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector(".menu-button");
  const nav = document.querySelector(".nav");
  const navLinks = nav?.querySelectorAll("a") ?? [];

  // Open the nav dropdown menu when the menu button is clicked.
  menuButton?.addEventListener("click", () => {
    const isOpen = menuButton.getAttribute("aria-expanded") === "true";
    menuButton.setAttribute("aria-expanded", (!isOpen).toString());
    nav?.classList.toggle("open");
  });

  // Close the nav dropdown menu when a nav link is clicked.
  for (const link of navLinks)
    link.addEventListener("click", () => {
      menuButton?.setAttribute("aria-expanded", "false");
      nav?.classList.remove("open");
    });

  // Close the nav dropdown menu when the user clicks outside of it.
  document.addEventListener("click", ({ target }) => {
    if (target instanceof Element && !target.closest("header")) {
      menuButton?.setAttribute("aria-expanded", "false");
      nav?.classList.remove("open");
    }
  });
</script>

<!--
Layouts ([Left] [Right])
- Wide: [Handle] [Nav, Language Select]
- Narrow: [Handle] [Language Select, Nav Menu Button]
-->
<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    justify-content: center;
    background-color: var(--color-bg-float);
    font-family: var(--font-mono);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 var(--content-padding-x);
    width: min(100%, var(--content-max-width));
  }

  .header-title {
    font-weight: bold;
    text-decoration: none;
    color: var(--color-accent);
  }

  .header-title:hover {
    color: var(--color-accent-dim);
  }

  .header-end {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .menu-button {
    display: none;
    align-items: center;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font-size: 1.25rem;
    cursor: pointer;
  }

  /* Narrow: the nav routes collapse into the menu button's dropdown. */
  @media (max-width: 715px) {
    .menu-button {
      display: inline-flex;
    }
  }
</style>
