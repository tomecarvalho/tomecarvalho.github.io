---
import type { MarkdownContent } from "../i18n/types";

export interface Props {
  Content: MarkdownContent;
}

const { Content } = Astro.props;
---

<div class="rich-text">
  <Content />
</div>

<style>
  .rich-text :global(:first-child) {
    margin-top: 0;
  }

  .rich-text :global(:last-child) {
    margin-bottom: 0;
  }

  .rich-text :global(p),
  .rich-text :global(ul),
  .rich-text :global(ol),
  .rich-text :global(blockquote),
  .rich-text :global(pre),
  .rich-text :global(table),
  .rich-text :global(h1),
  .rich-text :global(h2),
  .rich-text :global(h3),
  .rich-text :global(h4),
  .rich-text :global(h5),
  .rich-text :global(h6) {
    margin-bottom: 1rem;
  }

  .rich-text :global(h1),
  .rich-text :global(h2),
  .rich-text :global(h3),
  .rich-text :global(h4),
  .rich-text :global(h5),
  .rich-text :global(h6) {
    margin-top: 1.5rem;
    line-height: 1.25;
  }

  .rich-text :global(ul),
  .rich-text :global(ol) {
    padding-left: 1.5rem;
  }

  .rich-text :global(ul) {
    list-style: disc;
  }

  .rich-text :global(ol) {
    list-style: decimal;
  }

  .rich-text :global(li + li) {
    margin-top: 0.35rem;
  }

  .rich-text :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: 1rem;
    color: var(--color-fg-dim);
  }

  .rich-text :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    background-color: var(--color-surface);
  }

  .rich-text :global(pre) {
    overflow-x: auto;
    padding: 0.85rem 1rem;
    background-color: var(--color-surface);
  }

  .rich-text :global(pre code) {
    padding: 0;
    background: none;
  }

  .rich-text :global(table) {
    width: 100%;
    border-collapse: collapse;
  }

  .rich-text :global(th),
  .rich-text :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .rich-text :global(th) {
    background-color: var(--color-surface);
  }

  .rich-text :global(hr) {
    margin: 1.5rem 0;
    border: none;
    border-top: 1px solid var(--color-border);
  }

  .rich-text :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
