---
import { Icon } from "astro-icon/components";
import type { TranslatedNavRoute } from "../routes/nav-routes";
import Paper from "./Paper.astro";
import Stack from "./Stack.astro";

type Props = TranslatedNavRoute;

const { path, label, description, icon } = Astro.props;
---

<a class="explore-card" href={path}>
  <Paper hoverable>
    <Stack
      direction="row"
      gap={2}
      justifyContent="space-between"
      alignItems="flex-start"
    >
      <Stack gap={1}>
        <h3>{label}</h3>
        <p>{description}</p>
      </Stack>
      <Stack center height="100%">
        <Icon name={icon} size="
        4rem" />
      </Stack>
    </Stack>
  </Paper>

  <style>
    .explore-card {
      text-decoration: none;
      width: 100%;
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .explore-card :global(.paper) {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .explore-card :global(.paper) > :global(.stack) {
      flex: 1;
    }
  </style>
</a>
