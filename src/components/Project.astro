---
import Paper from "./Paper.astro";
import Paragraphs from "./Paragraphs.astro";
import Stack from "./Stack.astro";

interface Props {
  name: string;
  description: string;
  href: string;
  imageUrl?: string;
}

const { name, description, href, imageUrl } = Astro.props;
---

<Paper class="paper" hoverable>
  <a href={href} class="anchor">
    <Stack direction="row" gap={2}>
      <Stack gap={2}>
        <h3>{name}</h3>
        <Paragraphs paragraphs={description} />
      </Stack>
      {!!imageUrl && <img src={imageUrl} alt="" class="project-image" />}
    </Stack>
  </a>
</Paper>

<style>
  .project-image {
    max-width: 250px;
    max-height: 100%;
    object-fit: contain;
  }

  .anchor:hover {
    text-decoration: none;
  }

  .paper:hover {
    background-color: red !important;
  }
</style>
