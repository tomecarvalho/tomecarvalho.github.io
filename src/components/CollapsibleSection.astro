---
import type { Props as WindowProps } from "./Window.astro";
import Window from "./Window.astro";

export type Props = Pick<WindowProps, "id" | "icon" | "defaultOpen"> & {
  name: WindowProps["title"];
};

const { id, name, icon, defaultOpen } = Astro.props;
---

<Window id={id} title={name} icon={icon} titleAs="h2" defaultOpen={defaultOpen}>
  <slot />
</Window>
