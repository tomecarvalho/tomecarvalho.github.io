---
import type { Spacing } from "../style/theme";
import type { AsProp } from "../types/component/AsProp";
import { toStyle } from "../utils/style";

/** `alignItems` and/or `justifyContent`, or exclusively `center` (shorthand). */
type AlignProps =
  | {
      center?: never;

      alignItems?: CSSStyleDeclaration["alignItems"];
      justifyContent?: CSSStyleDeclaration["justifyContent"];
    }
  | {
      center?: true;

      alignItems?: never;
      justifyContent?: never;
    };

type Props = {
  gap?: Spacing;
  class?: string;
  direction?: "row" | "column";
  height?: CSSStyleDeclaration["height"];
  wrap?: boolean;
  fullWidth?: boolean;
} & AlignProps &
  AsProp;

const {
  gap,
  center,
  class: className,
  direction,
  height,
  wrap,
  fullWidth,
  as: Tag = "div",
} = Astro.props;

const { alignItems, justifyContent } = center
  ? { alignItems: "center", justifyContent: "center" }
  : Astro.props;

const horizontal = direction === "row";

const style = toStyle({ gap, alignItems, justifyContent, height });
---

<Tag
  class:list={["stack", className, { horizontal, wrap, fullWidth }]}
  style={style}
>
  <slot />
</Tag>

<style>
  .stack {
    display: flex;
    flex-direction: column;
  }
  .stack.horizontal {
    flex-direction: row;
  }
  .stack.wrap {
    flex-wrap: wrap;
  }
  .stack.fullWidth {
    width: 100%;
  }
</style>
