---
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-ext-400.css";
import "@fontsource/ibm-plex-mono/latin-ext-700.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-700.css";
import "@fontsource/ibm-plex-sans/latin-ext-400.css";
import "@fontsource/ibm-plex-sans/latin-ext-700.css";
import Footer from "../components/Footer.astro";
import type { Props as HeaderProps } from "../components/Header.astro";
import Header from "../components/Header.astro";
import {
  getLanguageOptions,
  getLocale,
  toLocalePath,
  translate,
  useTranslations,
} from "../i18n/utils";
import { navRoutes, navRoutesArray } from "../routes/nav-routes";
import { getContactEntries, getSearchEntries } from "../search";
import { SEARCH_MODES } from "../search/constants";
import siteConfig from "../site/config";
import "../style/kanagawa.css";

type Props = Pick<HeaderProps, "title">;

const {
  currentLocale,
  url: { pathname },
  props: { title },
} = Astro;

const locale = getLocale(currentLocale);
const t = useTranslations(currentLocale);

const languageOptions = getLanguageOptions(pathname, currentLocale);
const searchEntries = getSearchEntries(currentLocale);

const translatedNavRoutes: HeaderProps["routes"] = navRoutesArray.map(
  (route) => ({
    ...route,
    originalPath: route.path,
    path: toLocalePath(locale, route.path),
    label: t(route.label, { capitalize: true }),
    description: "description" in route ? t(route.description) : undefined,
  }),
);

const translatedSearchModes = translate(SEARCH_MODES, currentLocale);

const headerTitle = `~/${siteConfig.handle}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global>
      :root {
        /* Wide enough that the window chrome doesn't eat into the content. */
        --content-max-width: 940px;
        --content-padding-x: 2rem;
        --header-height: 1.5rem;
        --font-sans: "IBM Plex Sans", system-ui, sans-serif;
        --font-mono: "IBM Plex Mono", ui-monospace, monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      /* The header sticks to the top, so anchors have to land clear of it. */
      html {
        scroll-padding-top: calc(var(--header-height) + 0.5rem);
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        margin: 0;
        font-family: var(--font-sans);
        line-height: 1.5;
        background-color: var(--color-bg);
        color: var(--color-fg);
        scrollbar-color: var(--color-surface-hover) var(--color-bg);
      }

      ::selection {
        background-color: var(--color-selection);
      }

      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
      }

      a {
        color: var(--color-link);
      }

      a:hover {
        color: var(--color-link-hover);
      }

      select {
        padding: 0 0.25rem;
        border: none;
        background-color: var(--color-bg-float);
        color: var(--color-fg);
        font-family: inherit;
        font-size: inherit;
      }

      /* Vertical rhythm comes from layout gaps, not from default margins. */
      h1,
      h2,
      h3,
      h4,
      h5,
      h6,
      p,
      ul,
      ol {
        margin: 0;
      }

      ul {
        padding: 0;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6,
      code,
      kbd,
      samp,
      pre,
      .button {
        font-family: var(--font-mono);
      }

      h1 {
        color: var(--color-heading-1);
      }

      h2 {
        color: var(--color-heading-2);
      }

      h3 {
        color: var(--color-heading-3);
      }

      h4 {
        color: var(--color-heading-4);
      }

      /*
       * Window chrome, after a tiling window manager's titlebar and border.
       * Global so that any component can dress its content as a window.
       */
      .window {
        border: 2px solid var(--color-surface);
        background-color: var(--color-bg);
      }

      .window-title {
        display: flex;
        align-items: center;
        height: 1.5em;
        padding: 0 0.5rem;
        background-color: var(--color-surface);
        color: var(--color-fg-muted);
        font-family: var(--font-mono);
        font-size: 1rem;
        font-weight: normal;
        line-height: 1.5;
      }

      /* The titlebar doubles as the control that shades the window. */
      .window-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        width: 100%;
        padding: 0;
        border: none;
        background: none;
        color: inherit;
        font: inherit;
        cursor: pointer;
      }

      .window-name {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      /*
       * A line box reserves room for descenders that most titles never use, so
       * centring it leaves the text looking low. Trim to the x-height instead.
       */
      .window-label {
        text-box: trim-both ex alphabetic;
      }

      /* The trim leaves the icon centred on the x-height, where it reads low;
         raise it onto the cap band so it sits level with the letters. */
      .window-name svg {
        position: relative;
        top: -0.125em;
      }

      .window-content {
        padding: 1rem;
      }

      /* Focused window, as a window manager marks the one holding the cursor. */
      .window:hover,
      .window:focus-within {
        border-color: var(--color-selection);
      }

      .window:hover > .window-title,
      .window:focus-within > .window-title {
        background-color: var(--color-selection);
        color: var(--color-fg);
      }

      /* Layout-only hook for links that pair an icon with a label. */
      .button {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        width: fit-content;
      }

      .text-secondary {
        font-size: 0.875rem;
        color: var(--color-fg-dim);
      }

      .text-tertiary {
        font-size: 0.8125rem;
        color: var(--color-fg-muted);
      }

      .tooltip-wrapper {
        position: relative;
        display: inline-block;
      }

      .tooltip {
        position: fixed;
        z-index: 10;
        width: max-content;
        max-width: min(20rem, 90vw);
        padding: 0.25rem 0.5rem;
        background-color: var(--color-bg-float);
        color: var(--color-fg-dim);
        font-size: 0.8125rem;
        white-space: normal;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
      }

      .tooltip-wrapper:hover .tooltip,
      .tooltip-wrapper:focus-visible .tooltip {
        opacity: 1;
        visibility: visible;
      }

      @media (max-width: 700px) {
        :root {
          --content-padding-x: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <Header
      routes={translatedNavRoutes}
      contacts={getContactEntries(currentLocale)}
      title={headerTitle}
      homeHref={toLocalePath(locale, navRoutes.aboutMe.path)}
      languageOptions={languageOptions}
      searchEntries={searchEntries}
      launcherText={{
        routesPrompt: t("launcher.modes.routes"),
        contactsPrompt: t("launcher.modes.contacts"),
        searchPrompt: t("launcher.modes.search"),
        languagePrompt: t("launcher.modes.language"),
        filter: t("launcher.filter"),
        hints: t("launcher.hints"),
      }}
      openLauncherLabel={t("launcher.open")}
      openLanguageLabel={t("launcher.openLanguage")}
    />
    <main class="main">
      <slot />
    </main>
    <Footer
      searchModes={translatedSearchModes}
      hintsLabel={t("launcher.hints")}
    />
  </body>
</html>

<style>
  .main {
    flex: 1;
    margin: 0 auto;
    padding: 2rem var(--content-padding-x) calc(2rem + 1.5rem);
    width: min(100%, var(--content-max-width));
  }
</style>
