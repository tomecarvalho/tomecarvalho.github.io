---
import type { Props as HeaderProps } from "../components/Header.astro";
import Header from "../components/Header.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLanguageOptions, getLocale, useTranslations } from "../i18n/utils";
import { navRoutes } from "../routes/nav-routes";
import { site } from "../site";

type Props = Pick<HeaderProps, "title">;

const { title } = Astro.props;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);

const languageOptions = getLanguageOptions(
  Astro.url.pathname,
  Astro.currentLocale,
);

const toLocalePath = (path: string) =>
  getRelativeLocaleUrl(locale, path === "/" ? "" : path.replace(/^\//, ""));

const translatedNavRoutes: HeaderProps["routes"] = navRoutes.map((route) => ({
  path: toLocalePath(route.path),
  label: t(route.label, { capitalize: true }),
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
    </style>
    <style>
      .body {
        font-family: system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .main {
        flex: 1;
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
        width: 100%;
      }
    </style>
  </head>
  <body class="body">
    <Header
      routes={translatedNavRoutes}
      title={site.name}
      homeHref={toLocalePath("/")}
      languageOptions={languageOptions}
    />
    <main class="main">
      <slot />
    </main>
  </body>
</html>
