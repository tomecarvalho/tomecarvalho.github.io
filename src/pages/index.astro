---
import type { Props as IndexPageProps } from "../components/IndexPage.astro";
import IndexPage from "../components/IndexPage.astro";
import { useTranslations } from "../i18n/utils";
import siteConfig from "../site/config";
import { splitParagraphs } from "../utils/string";

const t = useTranslations(Astro.currentLocale);

const text: IndexPageProps["text"] = {
  title: t("nav.aboutMe"),
  name: siteConfig.name,
  role: t(siteConfig.i18n.role),
  location: t(siteConfig.i18n.location),
  description: splitParagraphs(t(siteConfig.i18n.aboutMeDescription)),
} as const;
---

<IndexPage text={text} contacts={siteConfig.contacts} />
