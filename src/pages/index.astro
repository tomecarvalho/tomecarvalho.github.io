---
import type { Props as IndexPageProps } from "../components/IndexPage.astro";
import IndexPage from "../components/IndexPage.astro";
import {
  getLocale,
  toLocalePath,
  translate,
  useTranslations,
} from "../i18n/utils";
import { exploreRoutesArray } from "../routes/nav-routes";
import siteConfig from "../site/config";

const { currentLocale } = Astro;

const t = useTranslations(currentLocale);

const text: IndexPageProps["text"] = {
  title: t("nav.aboutMe"),
  name: siteConfig.name,
  role: t(siteConfig.intro.role),
  location: t(siteConfig.intro.location),
  description: translate(siteConfig.intro.description, currentLocale),
  explore: t("index.titles.explore"),
} as const;

const exploreRoutes: IndexPageProps["exploreRoutes"] = exploreRoutesArray.map(
  (route) => {
    const translatedRoute = translate(route, currentLocale);

    return {
      ...translatedRoute,
      path: toLocalePath(getLocale(currentLocale), translatedRoute.path),
    };
  },
);
---

<IndexPage
  text={text}
  contacts={siteConfig.contacts}
  exploreRoutes={exploreRoutes}
/>
