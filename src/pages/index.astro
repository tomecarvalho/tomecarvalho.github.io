---
import type { Props as IndexPageProps } from "../components/IndexPage.astro";
import IndexPage from "../components/IndexPage.astro";
import { useTranslations } from "../i18n/utils";
import siteConfig from "../site/config";

const t = useTranslations(Astro.currentLocale);

const text: IndexPageProps["text"] = {
  title: t("nav.aboutMe"),
  name: siteConfig.name,
  role: t(siteConfig.intro.role),
  location: t(siteConfig.intro.location),
  description: t(siteConfig.intro.description),
  explore: t("index.titles.explore"),
} as const;
---

<IndexPage text={text} contacts={siteConfig.contacts} />
