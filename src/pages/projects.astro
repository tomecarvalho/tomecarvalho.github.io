---
import type { Props as ProjectsPageProps } from "../components/ProjectsPage.astro";
import ProjectsPage from "../components/ProjectsPage.astro";
import { translate, useTranslations } from "../i18n/utils";
import siteConfig from "../site/config";

const t = useTranslations(Astro.currentLocale);

const coursework: ProjectsPageProps["coursework"] = translate(
  siteConfig.coursework,
  Astro.currentLocale,
);

const projectCategories: ProjectsPageProps["projectCategories"] = translate(
  siteConfig.projects,
  Astro.currentLocale,
);

const text: ProjectsPageProps["text"] = {
  title: t("nav.projects"),
  coursework: t("terms.universityCoursework"),
};
---

<ProjectsPage
  text={text}
  coursework={coursework}
  projectCategories={projectCategories}
/>
